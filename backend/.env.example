# ShadowGuard AI — backend (Python risk engine) environment.
# Copy to backend/.env for local runs, or set these in the Vercel project.

# Neon / Supabase PostgreSQL. Use the POOLED connection string. sslmode=require is
# mandatory for any non-local host; the app refuses to connect without it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# SHA-256 digests of the API keys, one entry per key: role:digest, comma-separated.
# Generate with: python backend/scripts/create_api_key.py viewer|ingest|admin
SHADOWGUARD_API_KEYS=viewer:REPLACE_WITH_DIGEST,ingest:REPLACE_WITH_DIGEST,admin:REPLACE_WITH_DIGEST

# production | development | test. Keep "production" on Vercel.
SHADOWGUARD_ENV=production

# Interactive API docs at /api/docs. Leave false in production.
ENABLE_DOCS=false

# Only needed if a browser calls the API directly (the dashboard does not). https origins only.
ALLOWED_ORIGINS=

# Requests a minute per instance for each IP and each key. Every dashboard user shares the
# dashboard's key, so this is their combined ceiling; the dashboard caps each user first.
RATE_LIMIT_PER_MINUTE=600
EXPOSURE_WINDOW_DAYS=7
# Raw traffic events (the only rows with a hashed person) are deleted after this many days.
TELEMETRY_RETENTION_DAYS=90

# Optional: Microsoft Teams incoming-webhook URL for real nudges. Empty = nudges are "simulated".
TEAMS_WEBHOOK_URL=

# Optional: enables Gemini extraction in Stage 2. Every claim still passes the quote-match guard.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
