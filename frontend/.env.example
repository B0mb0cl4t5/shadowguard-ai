# ShadowGuard AI — frontend (Next.js dashboard) environment.
# Copy to frontend/.env.local for local runs, or set these in the Vercel frontend project.
# NONE of these use the NEXT_PUBLIC_ prefix: they stay on the server and never reach the browser.

# Base URL of the backend deployment (https required unless it is localhost).
SHADOWGUARD_API_URL=http://127.0.0.1:8000

# Raw API keys printed by backend/scripts/create_api_key.py (the backend only stores their digests).
SHADOWGUARD_VIEWER_API_KEY=
SHADOWGUARD_ADMIN_API_KEY=

# Access-code hashes for signing in. Generate with: npm run hash-password -- --generate
DASHBOARD_ADMIN_CODE_HASH=
DASHBOARD_VIEWER_CODE_HASH=

# At least 32 random characters. Generate with: npm run gen-secret
SESSION_SECRET=
