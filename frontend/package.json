{
  "name": "shadowguard-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/safe-next.test.mjs lib/password.test.mjs lib/demo-mode.test.mjs lib/rate-limit.test.mjs lib/design-contract.test.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\""
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
